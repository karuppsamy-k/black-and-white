rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isShopkeeper(shopId) {
      return isAuthenticated() && request.auth.uid == shopId;
    }

    // Customer Users Collection (/users)
    match /users/{userId} {
      // Customers can read and update only their own profile
      // Admins can read all customer profiles and update accountStatus
      allow read: if isOwner(userId) || isAdmin();
      
      // New customer can create their own profile with 'customer' role
      allow create: if isOwner(userId) 
        && request.resource.data.role == 'customer'
        && request.resource.data.accountStatus == 'Active'
        && !('password' in request.resource.data)
        && !('passwordHash' in request.resource.data);

      // Customer can update profile, but CANNOT change role or accountStatus
      // Admin can update accountStatus
      allow update: if (isOwner(userId) 
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountStatus == resource.data.accountStatus
          && !('password' in request.resource.data))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // Shopkeepers Collection (/shopkeepers)
    match /shopkeepers/{shopId} {
      // Anyone can read approved active shopkeepers' public details (store directory)
      // The shopkeeper owner can read their own document
      // Admins can read all shopkeeper applications
      allow read: if resource.data.approvalStatus == 'Approved' 
        || isShopkeeper(shopId) 
        || isAdmin();

      // New merchant can register with 'Pending' approval status
      allow create: if isShopkeeper(shopId)
        && request.resource.data.role == 'shopkeeper'
        && request.resource.data.approvalStatus == 'Pending'
        && request.resource.data.accountStatus == 'Inactive'
        && !('password' in request.resource.data)
        && !('passwordHash' in request.resource.data);

      // Shopkeeper can update their own shop details but CANNOT alter approvalStatus or accountStatus
      // Only Admin can modify approvalStatus or accountStatus
      allow update: if (isShopkeeper(shopId) 
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && request.resource.data.accountStatus == resource.data.accountStatus
          && request.resource.data.role == 'shopkeeper'
          && !('password' in request.resource.data))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // Products Collection (/products)
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isAuthenticated() && (
        (request.resource.data.shopId == request.auth.uid && exists(/databases/$(database)/documents/shopkeepers/$(request.auth.uid)))
        || isAdmin()
      );
    }

    // Orders Collection (/orders)
    match /orders/{orderId} {
      // Customer who placed order, the shopkeeper receiving it, or admin can read
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid
        || resource.data.shopId == request.auth.uid
        || isAdmin()
      );

      // Customers can create an order for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.customerId == request.auth.uid;

      // Shopkeeper can update order status (Preparing, Ready, Out for delivery)
      allow update: if isAuthenticated() && (
        resource.data.shopId == request.auth.uid
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Admins Collection (/admins)
    match /admins/{adminId} {
      // Only existing admins can read or manage admin list
      allow read, write: if isAdmin();
    }
  }
}
